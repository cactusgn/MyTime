<UserControl x:Class="Summary.Domain.AddCategoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:Summary.Domain"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:cv="clr-namespace:Summary.Common.Converter"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             FontSize="15"
             mc:Ignorable="d">
    <UserControl.Resources>
        <cv:TimeConverter x:Key="timeConverter"/>
        <cv:DateConverter x:Key="dateConverter"/>


    </UserControl.Resources>

    <Grid Margin="16,0,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="4" >
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Title}"></TextBlock>
        </Border>
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="Gray" VerticalAlignment="Bottom"></Border>
        <StackPanel  Margin="20,10,15,0" VerticalAlignment="Center" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" >
            <TextBlock VerticalAlignment="Center" Text="类名：">
            </TextBlock>
            <TextBox VerticalAlignment="Center" Margin="15,0,0,0"  Width="150" wpf:HintAssist.Hint="请输入类别名">
                <Binding Path="Category" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <domain:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            
            
        </StackPanel>
        <CheckBox Margin="0,10,0,0" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Visible}" 
          Content="是否显示在类别中"></CheckBox>
        <TextBlock  Margin="20,0,0,0"  Grid.Row="2" Visibility="{Binding ShowInvalidCateMessage}" 
                    Foreground="IndianRed"
                    VerticalAlignment="Center" Text="已存在该类名，请重新输入">
        </TextBlock>
        <StackPanel Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Margin="20,10,15,0">
            <TextBlock VerticalAlignment="Center" Visibility="{Binding ParentVisible}" >父类别：</TextBlock>
            <ComboBox  VerticalAlignment="Center" Width="150" 
                       ItemsSource="{Binding ParentCategoryList}" 
                       DisplayMemberPath="ParentCategoryName" 
                       SelectedValuePath="ParentCategoryId" 
                       IsEnabled="{Binding ParentEnabled}"
                       Visibility="{Binding ParentVisible}" 
                       IsEditable="True"
                       Text="{Binding ParentName}"
                       SelectedValue="{Binding ParentId}">
   
            </ComboBox>
           
        </StackPanel>
        <CheckBox VerticalAlignment="Center" Margin="20,10,0,0" IsChecked="{Binding AutoCreateTask}" 
           Visibility="{Binding AutoCreateTaskVisible}"
            Grid.Row="3" Grid.Column="0" 
           Content="自动建任务"></CheckBox>
        <CheckBox VerticalAlignment="Center" Margin="0,10,0,0" IsChecked="{Binding ShowInRecordPage}" 
     Visibility="{Binding ShowInRecordPageVisible}"
       Grid.Row="3" Grid.Column="1" 
     Content="是否显示在记录页面"></CheckBox>
        <StackPanel Margin="20,8,0,0" Grid.Row="4"  Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock VerticalAlignment="Center" Text="颜色："></TextBlock>
            <Border Background="{Binding Path=Text, ElementName=colorbox}" Width="10" Height="10"></Border>
            <TextBox Margin="5,0,10,2" x:Name="colorbox"
                       DockPanel.Dock="Top"
                       Text="{Binding Color, ElementName=ColorPicker, UpdateSourceTrigger=PropertyChanged}" />
           
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock  VerticalAlignment="Center" Text="回报率："></TextBlock>
            <TextBox Margin="2,0,10,2"
            DockPanel.Dock="Top" TextAlignment="Center"
            Text="{Binding Bonus}" Width="45" />
        </StackPanel>
        <materialDesign:ColorPicker Grid.Row="5" x:Name="ColorPicker"  Height="100"
                                    Margin="20,10"  Grid.ColumnSpan="2"
                                        Color="{Binding SelectedColor, Delay=25}" />
      
        <Grid Grid.Row="6" Grid.ColumnSpan="2"
                Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="113*"></ColumnDefinition>
                <ColumnDefinition Width="47*"/>
                <ColumnDefinition Width="160*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
               IsCancel="True" Grid.Column="0" Width="100" Margin="60,0,0,0"
              Style="{StaticResource MaterialDesignFlatButton}" Content="{Binding NoCaption}" Grid.ColumnSpan="2">
                <Button.CommandParameter>
                    <sys:Boolean>False</sys:Boolean>
                </Button.CommandParameter>
            </Button>
            <Button Grid.Column="2"
              Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
               Width="100" Margin="0,0,60,0" IsDefault="True"
              Style="{StaticResource MaterialDesignFlatButton}" Content="{Binding YesCaption}">
                <Button.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                </Button.CommandParameter>
            </Button>

        </Grid>
    </Grid>
</UserControl>
