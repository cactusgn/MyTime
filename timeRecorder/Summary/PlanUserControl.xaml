<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Summary"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Summary.PlanUserControl"
             xmlns:uc="clr-namespace:Summary.Domain" xmlns:col="clr-namespace:System.Collections;assembly=System.Collections.NonGeneric"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DesignHeight="450" d:DesignWidth="1000">
    <UserControl.Resources>
      
    </UserControl.Resources>
    <materialDesign:DialogHost DialogTheme="Inherit" x:Name="DialogHost"
                          Identifier="RootDialog"  IsOpen="{Binding IsDialogOpen}">
        <materialDesign:DialogHost.DialogContent>
            <!--这里放遮罩层的内容，比如我的是一个加载动画和一个登录中的文字
           不在这里定义内容也可以，可以在触发的控件的CommandParameter里面写
           也可以是在cs代码里面传DialogHost.Show(viewOrModel);-->
         <uc:SampleProgressDialog ></uc:SampleProgressDialog>
        </materialDesign:DialogHost.DialogContent>
        <materialDesign:DrawerHost  IsRightDrawerOpen="{Binding ElementName=ThemeToggleButton, Path=IsChecked}">
            <materialDesign:DrawerHost.RightDrawerContent>
                <DockPanel Width="420">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="16,10"  VerticalAlignment="Center" Height="50">
                        <TextBlock Height="30" Style="{DynamicResource MaterialDesignHeadline6TextBlock}"  Text="请选择你想要的主题："/>
                        <ToggleButton Height="30" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="{Binding ShowHiddenItems}"  Command="{Binding ShowHiddenItemsCheckedCommand}"
                          Width="40">
                        </ToggleButton>
                        <TextBlock LineHeight="20" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center">隐藏类型</TextBlock>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Height="70" 
                                Background="{DynamicResource MaterialDesignDarkSeparatorBackground}"
                                VerticalAlignment="Center">
                        <Button Height="40" Width="350" Background="{DynamicResource PrimaryHueDarkBrush}">确定</Button>
                    </DockPanel>
                    <ListBox DockPanel.Dock="Top" x:Name="ThemeListBox"
                AutomationProperties.Name="ThemePagesListBox"
                ItemsSource="{Binding ThemeItems}"
                PreviewMouseLeftButtonUp="ThemeListBox_PreviewMouseLeftButtonUp"
                SelectedIndex="{Binding SelectedIndex}"
                SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource MaterialDesignNavigationListBox}"
                materialDesign:ListBoxItemAssist.ShowSelection="False">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
                        </ListBox.Resources>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                <i:InvokeCommandAction 
                        CommandParameter="{Binding }"
                        Command="{Binding DataContext.TodayListBoxSelectionChangeCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox,AncestorLevel=1}}"></i:InvokeCommandAction>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                <i:InvokeCommandAction 
CommandParameter="{Binding }"
Command="{Binding DataContext.TodayListBoxRightClickCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox,AncestorLevel=1}}"></i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBox.ItemTemplate>
                            <DataTemplate >
                                <StackPanel Orientation="Horizontal" >
                                    <CheckBox Margin="{Binding Margin}" IsChecked="{Binding Checked}" Background="DimGray" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Checked">
                                                <i:InvokeCommandAction 
 CommandParameter="{Binding }"
 Command="{Binding DataContext.CheckChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"></i:InvokeCommandAction>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="Unchecked">
                                                <i:InvokeCommandAction 
 CommandParameter="{Binding }"
 Command="{Binding DataContext.CheckChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"></i:InvokeCommandAction>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </CheckBox>
                                    <TextBlock Margin="0,0,0,0" 
                        AutomationProperties.AutomationId="ThemeItemPage"
                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </DockPanel>
            </materialDesign:DrawerHost.RightDrawerContent>
       
            <Grid Background="{DynamicResource MaterialDesignCardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" x:Name="upPanel" Background="{DynamicResource MaterialDesignCardBackground}" Orientation="Horizontal">
            <TextBlock  Text="起始日期" VerticalAlignment="Center" Margin="10" />
            <DatePicker
        Width="120" Margin="10" HorizontalContentAlignment="Center"
        materialDesign:CalendarAssist.IsHeaderVisible="False"
        materialDesign:HintAssist.Hint="Start Date" SelectedDate="{Binding StartTime}"/>
            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="10"/>
            <DatePicker
        Width="120" Margin="10"  HorizontalContentAlignment="Center"
        materialDesign:CalendarAssist.IsHeaderVisible="False"
        materialDesign:HintAssist.Hint="End Date" SelectedDate="{Binding EndTime}"/>
            <Button Content="确定"  Margin="10"  BorderBrush="LightPink" Background="LightPink" Command="{Binding ClickOkButtonCommand}" Foreground="Black"/>
            <Button Content="上月"  Margin="10" BorderBrush="AliceBlue" Background="AliceBlue" Command="{Binding ClickOkButtonCommand}" CommandParameter="LastMonth" Foreground="Black"/>
            <Button Content="下月"  Margin="10" BorderBrush="AliceBlue" Background="AliceBlue" Command="{Binding ClickOkButtonCommand}" CommandParameter="NextMonth" Foreground="Black"/>
            <Button Width="25" Height="25" Margin="10"  Command="{Binding ClickOkButtonCommand}" CommandParameter="ThisMonth"
        Background="{DynamicResource PrimaryHueMidBrush}"
        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
        ToolTip="本周">
                <materialDesign:PackIcon Kind="Restore" />
            </Button>
            <Button Content="选择主题"  Margin="10" BorderBrush="AliceBlue" Background="#99CC60" Command="{Binding ClickThemeButtonCommand}" Foreground="Black"/>
            <CheckBox x:Name="ThemeToggleButton" Visibility="Collapsed" IsChecked="{Binding ThemeOpen}"></CheckBox>
        </StackPanel>
        <Border Grid.Row="1" Margin="10,5">
            <StackPanel Orientation="Horizontal" Background="{StaticResource MaterialDesignLightSeparatorBackground}">
                <TextBlock >本日获得：</TextBlock>
                <TextBlock Margin="0,0,10,0" x:Name="TodayReward" Text="{Binding TodayRewardString}"></TextBlock>
                    <TextBlock >本日扣除：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="TodayMinus" Text="{Binding TodayMinusString}"></TextBlock>
                <TextBlock>本日总获得：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="TodayTotal" Text="{Binding TodayTotalString}"></TextBlock>
                <TextBlock>本周获得：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="WeekReward" Text="{Binding WeekRewardString}"></TextBlock>
                <TextBlock>本周扣除：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="WeekMinus" Text="{Binding WeekMinusString}"></TextBlock>
                <TextBlock>本周总获得：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="WeekTotal" Text="{Binding WeekTotalString}"></TextBlock>
                <TextBlock>当前周期获得：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="CurrentReward" Text="{Binding CurrentRewardString}"></TextBlock>
                <TextBlock>当前周期扣除：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="CurrentMinus" Text="{Binding CurrentMinusString}"></TextBlock>
                <TextBlock>当前周期总获得：</TextBlock>
                    <TextBlock Margin="0,0,10,0" x:Name="CurrentTotal" Text="{Binding CurrentTotalString}"></TextBlock>
                </StackPanel>
        </Border>
        <UniformGrid Grid.Row="2" Grid.Column="0" >
                <DataGrid  x:Name="TimeGrid" AutoGenerateColumns="False" 
                       ScrollViewer.CanContentScroll="True"
                      EnableColumnVirtualization ="False"
                       EnableRowVirtualization ="False"
                      HorizontalAlignment="Left" Margin="10,10,0,10"
                       
                       ItemsSource="{Binding TimeObjs}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- Default Background -->
                            <Setter Property="Background" Value="White" />

                            <!-- DataTrigger to change background based on a condition -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Background}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Background}" Value="0">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                                <!-- Trigger for MouseOver -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DDDDDD" />
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DDDDDD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

            </UniformGrid>
        </Grid>
     </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</UserControl>
